# syntax=docker/dockerfile:1
# Builds the web frontend and serves it with nginx. Adjust the build output folder if the
# framework doesn't write to dist/.
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
